{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": true,
			"defaultGradients": true,
			"defaultPalette": true,
			"_comment": "Color palette uses CSS custom properties (--hw-color-*) which are defined in heightwind_color_scheme_css(). Fallback values ensure colors render in contexts where custom properties may not be loaded.",
			"palette": [
				{
					"slug": "background",
					"color": "var(--hw-color-bg, #f8f8f9)",
					"name": "Background"
				},
				{
					"slug": "surface",
					"color": "var(--hw-color-surface, #ffffff)",
					"name": "Surface"
				},
				{
					"slug": "foreground",
					"color": "var(--hw-color-text, #666A76)",
					"name": "Foreground"
				},
				{
					"slug": "heading",
					"color": "var(--hw-color-heading, #444854)",
					"name": "Heading"
				},
				{
					"slug": "accent",
					"color": "var(--hw-color-accent, #53a1b8)",
					"name": "Accent"
				}
			]
		},
		"layout": {
			"contentSize": "1089px",
			"wideSize": "1400px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"customSpacingSize": true,
			"spacingSizes": [
				{
					"slug": "small",
					"size": "0.5rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "2rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "3rem",
					"name": "Extra Large"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.889rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.333rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "1.777rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "2.369rem",
					"name": "2X Large"
				}
			],
			"fontFamilies": [
				{
					"slug": "open-sans",
					"fontFamily": "'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "Open Sans"
				}
			],
			"lineHeight": true,
			"dropCap": true
		},
		"custom": {
			"spacing": {
				"baseline": "1.5rem"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--hw-color-bg)",
			"text": "var(--hw-color-text)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--open-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--hw-color-accent)"
				},
				":hover": {
					"color": {
						"text": "var(--hw-color-accent-hover)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--hw-color-heading)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.3"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.4"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.5"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				}
			},
			"button": {
				"color": {
					"background": "var(--hw-color-accent)",
					"text": "var(--hw-color-on-accent, #ffffff)"
				},
				":hover": {
					"color": {
						"background": "var(--hw-color-accent-hover)"
					}
				}
			}
		},
		"blocks": {
			"core/paragraph": {
				"spacing": {
					"margin": {
						"top": "0",
						"bottom": "1.5rem"
					}
				}
			},
			"core/heading": {
				"spacing": {
					"margin": {
						"top": "2rem",
						"bottom": "1rem"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--hw-color-border)"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--hw-color-code-bg)",
					"text": "var(--hw-color-code-text)"
				}
			}
		}
	}
}
